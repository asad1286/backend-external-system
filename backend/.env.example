# Port this backend listens on.
PORT=4000

# Where the browser opens the install / consent page (the myCRMSIM dashboard).
MYCRMSIM_DASHBOARD_URL=https://app.mycrmsim.com
# The myCRMSIM API. Local backend: http://localhost:5005
MYCRMSIM_API_URL=https://backend.mysmsgateway.app

# From Integrations -> Custom App Integration, once the app is approved.
CLIENT_ID=
CLIENT_SECRET=

# Must match the app's Redirect URI in myCRMSIM exactly.
# Default: http://localhost:<PORT>/oauth/callback
REDIRECT_URI=

# The public address of this backend (an ngrok tunnel to PORT), so myCRMSIM can
# reach the Callback URL: <PUBLIC_URL>/webhooks/mycrmsim. Empty = localhost only.
PUBLIC_URL=

# Where to send the browser after the install finishes (the frontend).
FRONTEND_URL=http://localhost:5173

# Password for the whole system (Basic auth); the Callback URL and /healthz stay open.
# Required when NODE_ENV=production. Empty = no password (fine on localhost).
APP_USER=admin
APP_PASSWORD=
